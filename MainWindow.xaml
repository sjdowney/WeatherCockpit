<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WeatherCockpit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WeatherCockpit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Weather Cockpit">

    <Grid x:Name="Root"
          Background="#0A0E1A"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Viewbox Stretch="UniformToFill"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid x:Name="CockpitRoot"
                  Width="1536"
                  Height="941"
                  Background="#0A0E1A">

                <!-- Background Image -->
                <Image x:Name="CockpitBackground"
                       Source="ms-appx:///Assets/Images/weather_cockpit_bg.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"/>

                <!-- Atmospheric text boxes -->
                <Canvas x:Name="AtmosphereLayer">

                    <!-- TEMP -->
                    <Grid Width="300" Height="80"
                      Canvas.Left="-10"
                      Canvas.Top="190">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TempValue"
                           Grid.Column="1"
                           Text="{Binding TempDisplay}"
                           FontSize="28"
                           Foreground="#00C8FF"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                    </Grid>

                    <!-- HUMIDITY -->
                    <Grid Width="300" Height="80"
                        Canvas.Left="-10"
                        Canvas.Top="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="HumidityValue"
                           Grid.Column="1"
                           Text="{Binding HumidityDisplay}"
                           FontSize="28"
                           Foreground="#00C8FF"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                    </Grid>

                    <!-- PRESSURE -->
                    <Grid Width="300" Height="80"
                      Canvas.Left="-10"
                      Canvas.Top="335">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PressureValue"
                           Grid.Column="1"
                           Text="{Binding PressureDisplay}"
                           FontSize="23"
                           Foreground="#00C8FF"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/> 
                    </Grid>

                </Canvas>

                <!-- TIDE BOX OVERLAY -->
                <Canvas x:Name="TideOverlay">
                    <!-- FIRST TIDE: TIME (above left peak) -->
                    <TextBlock x:Name="Tide1Time"
                        Text="{Binding HighTide}"
                        FontSize="27"
                        Foreground="#F8F8FF"
                        FontWeight="Bold"
                        Canvas.Top="605"
                        Canvas.Left="160"
                        Width="200"
                        Height="200"
                        Opacity="1"/>
                    
                    <!-- FIRST TIDE: HEIGHT (inside left peak) -->
                    <TextBlock x:Name="Tide1Height"
                       Text="{Binding HighTideTime}"
                       FontSize="27"
                       Foreground="#00C8FF"
                       FontWeight="Bold"
                       Canvas.Top="605"
                       Canvas.Left="230">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="Tide1HeightTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>


                    <!-- SECOND TIDE: TIME (above right peak) -->
                    <TextBlock x:Name="Tide2Time"
                       Text="{Binding LowTide}"
                       FontSize="27"
                       Foreground="White"
                       FontWeight="Bold"
                       Canvas.Top="660"
                       Canvas.Left="160"
                       Opacity="1"/>

                    <!-- SECOND TIDE: HEIGHT (inside right peak) -->
                    <TextBlock x:Name="Tide2Height"
                       Text="{Binding LowTideTime}"
                       FontSize="27"
                       Foreground="#00C8FF"
                       FontWeight="Bold"
                       Canvas.Top="660"
                       Canvas.Left="230"
                       Opacity="1">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="Tide2HeightTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                </Canvas>

                <!-- Lightning Radar -->
                <Canvas x:Name="LightningRadarLayer"/>

                <!-- Compass -->
                <Canvas x:Name="CompassCanvas"
                        Width="400"
                        Height="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Image x:Name="CompassNeedle"
                           Source="Assets/Images/needle.png"
                           Width="210"
                           Height="210"
                           Canvas.Left="124"
                           Canvas.Top="-20"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="NeedleRotation" Angle="0"/>
                        </Image.RenderTransform>
                    </Image>

                </Canvas>

                <Canvas x:Name="MoonPhaseLayer"
                    Canvas.Left="1000"
                    Canvas.Top="150"
                    Width="500"
                    Height="300">

                    <!-- Moon + Text Panel -->
                    <Grid Width="450"
                      Height="200"
                      Canvas.Left="460"
                      Canvas.Top="220">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Moon Image + glow -->
                        <Canvas Grid.Column="0"
                            Width="150"
                            Height="150"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!-- Tiny star speckles -->
                            <Ellipse Width="3" Height="3" Fill="White" Opacity="0.25" Canvas.Left="10" Canvas.Top="5"/>
                            <Ellipse Width="2" Height="2" Fill="White" Opacity="0.20" Canvas.Left="120" Canvas.Top="15"/>
                            <Ellipse Width="2" Height="2" Fill="White" Opacity="0.18" Canvas.Left="60" Canvas.Top="130"/>
                            <Ellipse Width="3" Height="3" Fill="White" Opacity="0.15" Canvas.Left="140" Canvas.Top="90"/>

                            <!-- Glow halos -->
                            <Ellipse Width="155" Height="155" Fill="#A0C8FF" Opacity="0.04" Canvas.Left="-2" Canvas.Top="-2"/>
                            <Ellipse Width="150" Height="150" Fill="White" Opacity="0.04" Canvas.Left="0" Canvas.Top="0"/>
                            <Ellipse Width="140" Height="140" Fill="#F8F8FF" Opacity="0.06" Canvas.Left="5" Canvas.Top="5"/>
                            <Ellipse Width="132" Height="132" Fill="#FFFFFF" Opacity="0.10" Canvas.Left="9" Canvas.Top="9"/>
                            <Ellipse Width="131" Height="131" Stroke="White" StrokeThickness="1" Opacity="0.25" Canvas.Left="9.5" Canvas.Top="9.5"/>

                            <!-- Moon image -->
                            <Image Source="{Binding MoonPhaseImage}"
                               Width="130"
                               Height="130"
                               Stretch="Uniform"
                               Canvas.Left="10"
                               Canvas.Top="10"/>
                        </Canvas>

                        <!-- Moon text -->
                        <Grid Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="30,0,0,0">

                            <!-- Starfield -->
                            <Canvas Width="250" Height="180">
                                <Ellipse Width="3" Height="3" Fill="White" Opacity="0.20" Canvas.Left="20" Canvas.Top="10"/>
                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.15" Canvas.Left="180" Canvas.Top="25"/>
                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.18" Canvas.Left="140" Canvas.Top="80"/>
                                <Ellipse Width="3" Height="3" Fill="White" Opacity="0.12" Canvas.Left="210" Canvas.Top="60"/>
                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.18" Canvas.Left="100" Canvas.Top="140"/>
                                <Ellipse Width="3" Height="3" Fill="White" Opacity="0.22" Canvas.Left="40" Canvas.Top="110"/>
                            </Canvas>

                            <StackPanel VerticalAlignment="Center" Spacing="10">

                                <!-- Glow text -->
                                <Grid>
                                    <TextBlock Text="{Binding MoonPhaseText}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Opacity="0.25"/>
                                    <TextBlock Text="{Binding MoonPhaseText}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="DarkCyan"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Rise:" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MoonRise}" Foreground="White" FontSize="22"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Set:" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MoonSet}" Foreground="White" FontSize="22"/>
                                </StackPanel>

                            </StackPanel>

                        </Grid>

                    </Grid>
                </Canvas>

                <!-- Environmental Layer -->
                <!-- Environmental Layer -->
                <Canvas x:Name="EnvironmentalLayer">

                    <!-- LIGHTNING ACTIVITY -->
                    <Canvas Canvas.Top="790" Canvas.Left="155">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LIGHTNING ACTIVITY"
                               FontSize="15"
                               Foreground="Cyan"
                               FontWeight="Bold"                        
                               Opacity="0.7"/>

                            <TextBlock x:Name="LightningValue"
                               Text="{Binding LightningActivityDisplay}"
                               FontSize="16"
                               Foreground="White">  
                                    <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LightningTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Canvas>


                    <!-- STORM RISK -->
                    <Canvas Canvas.Top="790" Canvas.Left="335">
                        <StackPanel Spacing="2">
                            <TextBlock Text="STORM RISK"
                       FontSize="16"
                       Foreground="Cyan"
                       FontWeight="Bold"
                       Opacity="0.7"/>

                            <TextBlock x:Name="StormLevel"
                               Text="{Binding StormLevel}"
                               FontSize="16"
                               Foreground="White">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="StormRiskTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Canvas>


                    <!-- INSTABILITY -->
                    <Canvas Canvas.Top="790" Canvas.Left="510">
                        <StackPanel Spacing="2">
                            <TextBlock Text="INSTABILITY"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="Cyan"                        
                               Opacity="0.7"/>

                            <TextBlock x:Name="InstabilityDriver"
                               Text="{Binding InstabilityDriver}"
                               FontSize="16"
                               Foreground="White">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="InstabilityTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Canvas>


                    <!-- MICROBURST SIGNATURE -->
                    <Canvas Canvas.Top="790" Canvas.Left="670">
                        <StackPanel Spacing="2">
                            <TextBlock Text="DPD Driver"
                               FontSize="16"
                               Foreground="Cyan"
                               FontWeight="Bold"
                               Opacity="0.7"/>

                            <TextBlock x:Name="DpdDriver"
                               Text="{Binding DpdDriver}"
                               FontSize="16"
                               Foreground="White">    
                                    <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="DpdDriverTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Canvas>


                    <!-- RAIN POTENTIAL -->
                    <Canvas Canvas.Top="790" Canvas.Left="840">
                        <StackPanel Spacing="2">
                            <TextBlock Text="RAIN POTENTIAL"
                               FontSize="16"
                               Foreground="Cyan"
                               FontWeight="Bold"
                               Opacity="0.7"/>

                            <TextBlock x:Name="RainPotentialValue"
                               Text="{Binding RainPotentialDisplay}"
                               FontSize="16"
                               Foreground="White">
                                        <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="RainPotentialTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Canvas>


                    <!-- STORM MOVEMENT -->
                    <Canvas Canvas.Top="790" Canvas.Left="1010">
                        <StackPanel Spacing="2">
                            <TextBlock Text="STORM MOVEMENT"
                               FontSize="16"
                               Foreground="Cyan"
                               FontWeight="Bold"
                               Opacity="0.7"/>

                            <TextBlock x:Name="StormMovementValue"
                               Text="{Binding StormMovementDisplay}"
                               FontSize="16"
                               Foreground="White">    
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="StormMovementTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Canvas>


                    <!-- ALERT LEVEL + Lightning Status -->
                    <Canvas Canvas.Top="790" Canvas.Left="1190">
                        <StackPanel Spacing="2">
                            <TextBlock Text="ALERT LEVEL"
                               FontSize="16"
                               Foreground="Cyan"
                               FontWeight="Bold"
                               Opacity="0.7"/>

                            <TextBlock x:Name="AlertLevelValue"
                               Text="{Binding AlertLevelDisplay}"
                               FontSize="16"
                               Foreground="White">
                                <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="AlertLevelTransform"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Lightning status moved here -->
                            <TextBlock x:Name="LightningStatusMessage"
                       Text="{Binding LightningStatusDisplay}"
                       FontSize="14"
                       Foreground="#00C8FF"
                       Opacity="0.8"
                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Canvas>


                    <!-- Animations (unchanged) -->
                    <Canvas.Resources>
                        <Storyboard x:Name="StormHudStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

                            <!-- Vertical pulse -->
                            <DoubleAnimation Storyboard.TargetName="LightningTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3"
                             Duration="0:0:1.2"/>

                            <DoubleAnimation Storyboard.TargetName="StormRiskTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3"
                             Duration="0:0:1.4"/>

                            <DoubleAnimation Storyboard.TargetName="InstabilityTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3"
                             Duration="0:0:1.6"/>

                            <DoubleAnimation Storyboard.TargetName="MicroburstTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3"
                             Duration="0:0:1.8"/>

                            <DoubleAnimation Storyboard.TargetName="RainPotentialTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3"
                             Duration="0:0:2.0"/>

                            <DoubleAnimation Storyboard.TargetName="StormMovementTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3"
                             Duration="0:0:2.2"/>

                            <DoubleAnimation Storyboard.TargetName="AlertLevelTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3"
                             Duration="0:0:2.4"/>

                            <!-- Glow pulse -->
                            <DoubleAnimation Storyboard.TargetName="LightningValue"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0"
                             Duration="0:0:1.2"/>

                            <DoubleAnimation Storyboard.TargetName="StormRiskValue"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0"
                             Duration="0:0:1.4"/>

                            <DoubleAnimation Storyboard.TargetName="InstabilityValue"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0"
                             Duration="0:0:1.6"/>

                            <DoubleAnimation Storyboard.TargetName="MicroburstValue"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0"
                             Duration="0:0:1.8"/>

                            <DoubleAnimation Storyboard.TargetName="RainPotentialValue"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0"
                             Duration="0:0:2.0"/>

                            <DoubleAnimation Storyboard.TargetName="StormMovementValue"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0"
                             Duration="0:0:2.2"/>

                            <DoubleAnimation Storyboard.TargetName="AlertLevelValue"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0"
                             Duration="0:0:2.4"/>

                        </Storyboard>
                    </Canvas.Resources>

                </Canvas>


                <!-- Scrolling Status -->
                <Canvas x:Name="ScrollLayer">
                    <Grid x:Name="StatusBox"
                          Width="606"
                          Height="26"
                          Canvas.Left="387"
                          Canvas.Top="868"
                          Padding="0,-3,0,0">

                        <Canvas x:Name="ScrollCanvas">
                            <TextBlock x:Name="ScrollText"
                                       Text="{Binding StatusMessage}"
                                       FontSize="26"
                                       Opacity="0.7"
                                       Foreground="#00C8FF"/>
                        </Canvas>

                    </Grid>
                </Canvas>

                <!-- Forecast -->
                <Canvas x:Name="ForecastLayer">
                    <Grid x:Name="ForecastBox"
                          Width="490"
                          Height="185"
                          Canvas.Left="990"
                          Canvas.Top="190"
                          Background="#4D000000">

                        <TextBlock x:Name="LocalForecastText"
                                   Text="{Binding LocalForecast}"
                                   FontSize="20"
                                   Foreground="#00C8FF"
                                   TextWrapping="Wrap"
                                   Margin="12"
                                   Width="466"/>
                    </Grid>
                </Canvas>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
